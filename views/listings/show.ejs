<% layout("/layouts/boilerplate.ejs") %>

    <body>

        <div class="row">
            <div class="col-8 offset-3">
                <h3 class="mt-2 mb-2"> <%= listing.title %></h3>
            </div>

            <div class="col-6 offset-3">
                <div class="card card-listing" style="width: 100%;">
                    <img src="<%=listing.image%>" class="card-img-top show-img" alt="listing-img">
                    <div class="card-body">
                        <p class="card-text">
                                <i> Owner: <%= listing.owner.username %> </i><br>
                                <%= listing.description %> <br>
                                &#8377;<%= listing.price.toLocaleString("en-PK") %> <br>
                                <%= listing.location %> <br>
                                <%= listing.country %> <br>
                        </p>
                    </div>
                </div>

            </div>


           <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
            <div class="btns mb-2">
                <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark edit-btn">Edit </a>
                <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
                    <button class="btn btn-dark offset-4">Delete</button>
                </form>
            </div>
            <% } %>

            <div class="col-8 offset-3">
                <% if(currUser) { %>
                    <hr />
                <h4>Leave a Review</h4>
                    <form method="POST" action="/listings/<%=listing._id%>/reviews" novalidate class="needs-validation">
                    <div>
                        <label class="form-label" for="rating">Range</label>
                        <input type="range" class="form-range" id="rating" min="1" max="5" name="review[rating]" >
                    </div>
                    <div>
                        <label class="form-label" for="comment">Comment</label>
                        <textarea class="form-control" name="review[comment]" cols="30" rows="10" required></textarea>
                        <div class="invalid-feedback">
                            Please add a comment for review
                        </div>
                    </div>
                    <button class="btn btn-outline-dark mt-2 mb-2">Submit</button>
                </form>
                <% } %>
            </div>

           <div class="col-8 offset-3">
            <hr />
             <h4>All Reviews</h4>
            <div class="row">
                <% for(review of listing.reviews) {  %>
                <div class="card mb-3 col-5 ms-5">
                    <div class="card-body">
                        <h5 class="card-title">@<%= review.author.username %></h5>
                        <p class="card-text"><%= review.comment %></p>
                        <!-- <p class="card-text"><%= review.rating %> stars</p> -->
                        <p class="card-text">
                           <% for (let i = 1; i <= 5; i++) { %>
                               <% if (i <= review.rating) { %>
                                  <i class="bi bi-star-fill text-warning"></i>
                               <% } else { %>
                                  <i class="bi bi-star text-warning"></i>
                               <% } %>
                            <% } %>
                        </p>
                        <form method="post" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                            <button class="btn btn-dark btn-sm">Delete</button>
                        </form>
                    </div>
                </div>
            <% } %>
            </div>
           </div>

        </div>

    </body>