<% layout("/layouts/boilerplate.ejs") %>

<div class="row">
    <div class="col-6 offset-3">
        <h1>LogIn for Wanderlust</h1>
        <form method="POST" action="/login" class="needs-validation" novalidate>
           <div class="mb-3">
             <label fro="username" class="from-label">Username</label>
            <input
                name="username",
                id="username",
                type="text",
                class="form-control"
                required
            >
           </div>


            <div class="mb-3">
                <label fro="password" class="from-label">Password</label>
            <input
                name="password",
                id="password",
                type="password",
                class="form-control"
                required
            >
            </div>

            <button class="btn btn-success">Login</button>
        </form>
    </div>
</div>