<% layout("/layouts/boilerplate.ejs") %>

<div class="row">
    <div class="col-6 offset-3">
        <h1>SignUp for Wanderlust</h1>
        <form method="POST" action="/signup" class="needs-validation" novalidate>
           <div class="mb-3">
             <label fro="username" class="from-label">Username</label>
            <input
                name="username",
                id="username",
                type="text",
                class="form-control"
                required
            >
            <div class="valid-feedback">Looks good!</div>
           </div>

          <div class="mb-3">
              <label fro="email" class="from-label">Email</label>
            <input
                name="email",
                id="email",
                type="email",
                class="form-control"
                required
            >
          </div>

            <div class="mb-3">
                <label fro="password" class="from-label">Password</label>
            <input
                name="password",
                id="password",
                type="password",
                class="form-control"
                required
            >
            </div>

            <button class="btn btn-success">SignUp</button>
        </form>
    </div>
</div>